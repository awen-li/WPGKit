execute_process(COMMAND git -C "${IREE_ROOT}" rev-parse HEAD
  RESULT_VARIABLE git_status OUTPUT_VARIABLE revision
  OUTPUT_STRIP_TRAILING_WHITESPACE)
if(NOT git_status EQUAL 0 OR
   NOT revision STREQUAL "1b60b62ed4b3f2a3c95f42b397889444c7df318c")
  message(FATAL_ERROR "IREE checkout must be candidate-20240724.964 at 1b60b62")
endif()
if(NOT EXISTS "${IREE_BUILD}/tools/iree-compile" OR
   NOT EXISTS "${IREE_BUILD}/lib/libIREECompiler.so")
  message(FATAL_ERROR "the linked iree-compile program is missing")
endif()
execute_process(COMMAND "${IREE_BUILD}/tools/iree-compile" --version
  RESULT_VARIABLE version_status OUTPUT_VARIABLE version)
if(NOT version_status EQUAL 0 OR NOT version MATCHES "IREE compiler version")
  message(FATAL_ERROR "the linked iree-compile program cannot run")
endif()
foreach(part exe lib)
  if(part STREQUAL "exe")
    set(map "${MAP_DIR}/iree-compile.map")
  else()
    set(map "${MAP_DIR}/libIREECompiler.map")
  endif()
  execute_process(COMMAND "${INVENTORY}" "${IREE_BUILD}" "${map}"
    RESULT_VARIABLE status OUTPUT_VARIABLE report ERROR_VARIABLE diagnostic)
  if(NOT status EQUAL 0)
    message(FATAL_ERROR "${part} linker map failed: ${diagnostic}")
  endif()
  string(JSON mapped LENGTH "${report}" mapped_objects)
  string(JSON unmapped LENGTH "${report}" unmapped_objects)
  string(JSON closed GET "${report}" linked_program_closed)
  if(closed OR unmapped LESS 1)
    message(FATAL_ERROR "${part} report concealed external or unmapped objects")
  endif()
  if(part STREQUAL "exe" AND mapped LESS 1)
    message(FATAL_ERROR "iree-compile launcher object was not mapped")
  endif()
  if(part STREQUAL "lib")
    string(FIND "${report}" "/compiler/Utils/StringUtils.cpp" expected)
    if(mapped LESS 1000 OR expected EQUAL -1)
      message(FATAL_ERROR "libIREECompiler linked source inventory is incomplete")
    endif()
  endif()
  message(STATUS "${part}: ${mapped} mapped objects, ${unmapped} unmapped objects")
endforeach()
execute_process(COMMAND "${INVENTORY}" "${IREE_BUILD}"
    "${MAP_DIR}/iree-compile.map" "${MAP_DIR}/libIREECompiler.map"
  RESULT_VARIABLE status OUTPUT_VARIABLE combined ERROR_VARIABLE diagnostic)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "combined linked inventory failed: ${diagnostic}")
endif()
string(JSON mapped LENGTH "${combined}" mapped_objects)
string(JSON map_count LENGTH "${combined}" link_maps)
if(mapped LESS 1600 OR NOT map_count EQUAL 2)
  message(FATAL_ERROR "combined inventory omitted executable or compiler library")
endif()
execute_process(COMMAND "${ANALYZER}" --link-map "${IREE_BUILD}"
    "${MAP_DIR}/iree-compile.map" main
  RESULT_VARIABLE status OUTPUT_VARIABLE graph ERROR_VARIABLE diagnostic)
if(NOT status EQUAL 0)
  message(FATAL_ERROR "real linked launcher CG/PTA failed: ${diagnostic}")
endif()
string(JSON analyzed GET "${graph}" analyzed_linked_objects)
string(JSON missing LENGTH "${graph}" unresolved_linked_symbols)
string(JSON closed GET "${graph}" linked_program_closed)
if(NOT analyzed EQUAL 1 OR missing LESS 1 OR closed)
  message(FATAL_ERROR "launcher CG/PTA concealed the shared-library boundary")
endif()
